.quarto/
/.quarto/
__pycache__/
*.pyc
.DS_Store
_update*.tgz
_to_delete/
**/*.quarto_ipynb

# LaTeX intermediates left in chapters/ when a .qmd is rendered to PDF. The PDF
# itself is wanted; these are not, and they reappear on every PDF render.
chapters/*.aux
chapters/*.log
chapters/*.tex
chapters/*.toc
chapters/*.out
chapters/*.fls
chapters/*.fdb_latexmk

# Temporary objects left behind when a git write is interrupted. A desktop bridge
# that cannot unlink files strands these, and 523 of them accumulated before the
# first clean-up; they are never part of the repository.
.git/objects/**/tmp_obj_*

# The published copy of the site must never be swept into the build output;
# see the resources exclusions in _quarto.yml. This is the second line of defence.
_site/docs/

# Transfer bundles the desktop bridge leaves in the project root when it moves a
# chapter's sources and rendered output across. They are a copy of tracked files,
# never a source, and a bare `git add -A` would otherwise commit them.
_u*.tgz
